          "falloutnv.esm:147864"
        ]
      },
      {
        "target": "01153A0F",
        "english": "Man, I'm sick of this place. Can't wait to get back to Red Rock.",
        "ko": "젠장, 여긴 이제 신물이 나. 하루빨리 붉은 바위로 돌아가고 싶구먼.",
        "origin_keys": [
          "falloutnv.esm:153a0f"
        ]
      },
      {
        "target": "01153A10",
        "english": "The NCR sure did a number on this place.",
        "ko": "NCR 놈들, 여길 제대로 작살내놨군.",
        "origin_keys": [
          "falloutnv.esm:153a10"
